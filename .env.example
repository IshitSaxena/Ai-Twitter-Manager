# ==============================================================
# X (Twitter) Interaction AI Agent - Environment Configuration
# ==============================================================

# AI Planning Configuration (Gemini API is default)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Optional: OpenRouter / NVIDIA API Key (for alternative LLM planning)
# OPEN_ROUTER_KEY=your_openrouter_api_key_here
# NVIDIA_MODEL=nvidia/nemotron-3.5-content-safety:free

# Target X (Twitter) Feed URL
TARGET_PAGE=https://x.com/home

# Interaction Budget & Limits
MAX_INTERACTIONS=10
MAX_SCROLL_ATTEMPTS=10
POSTS_PER_BATCH=15
DEEP_DIVE_ENABLED=true
MAX_INNER_INTERACTIONS=10

# Allowed Actions: list of actions e.g. ["like", "comment", "reply"]
ALLOWED_ACTIONS=["like", "comment", "reply"]

# Browser & Session Settings
HEADLESS=false
USER_DATA_DIR=./browser_data/x_profile
CHATGPT_USER_DATA_DIR=./browser_data/chatgpt_profile
DATABASE_PATH=./data/interactions.db

# Persona Configuration File
PERSONA_FILE=persona.json
